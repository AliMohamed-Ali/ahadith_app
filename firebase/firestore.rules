rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // المدير = أي مستخدم له مستند باسم الـ uid بتاعه في مجموعة admins
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // قائمة المديرين: يقرأ كل مدير مستنده فقط، ولا أحد يكتب من التطبيق (تضيفها من الكونسول)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // المحتوى: يقرأه كل الأطفال، ويكتبه المدير فقط
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tabs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /levels/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /hadiths/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /qaSections/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // مكتبة الوسائط: روابط الملفات المرفوعة على Cloudinary، للمدير بس
    match /media/{id} {
      allow read, write: if isAdmin();
    }

    // سجل الإشعارات: تكتبه الدالة السحابية فقط، ويقرأه المدير
    match /notificationsLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // لوحة الشرف: كل طفل (تسجيل مجهول) يكتب مستنده فقط، وبحقول محددة بدون صور أو مواقع دقيقة
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'avatar', 'city', 'area', 'stars', 'royal', 'score', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 12
        && request.resource.data.city is int
        && request.resource.data.area is string
        && request.resource.data.area.size() <= 30
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars < 100000
        && request.resource.data.royal is int && request.resource.data.royal >= 0 && request.resource.data.royal < 10000
        && request.resource.data.score is int;
    }
  }
}
